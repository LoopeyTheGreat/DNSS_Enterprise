# DNSS Enterprise - Environment Configuration Example
# Rename this file to .env and fill in your actual values

# CloudFlare Domain 1
DOMAIN1=example.com
CF_API_KEY1=your_cloudflare_api_key_here

# CloudFlare Domain 2 (optional)
DOMAIN2=example2.com
CF_API_KEY2=your_second_cloudflare_api_key_here

# You can add more domains by incrementing the number
# DOMAIN3=example3.com
# CF_API_KEY3=your_third_cloudflare_api_key_here

# Optional Discord webhook for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here